# HuggingFace token (optional — only needed if INFERENCE_MODE=hf or auto with HF fallback)
HF_API_KEY=

# local = on-device ViT (recommended for Docker/demo)
# hf = remote HuggingFace router API only
# auto = local first, then HF API
INFERENCE_MODE=local

# Frontend → backend URL (use http://backend:8000 inside Docker)
API_URL=http://localhost:8000

# Optional tuning
RATE_LIMIT=20
MAX_FILE_BYTES=10485760
MIN_CONFIDENCE=0.05
TOP_K=4
